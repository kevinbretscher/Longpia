executor {
  name = 'slurm'
  queueSize = 30
  submitRateLimit = '1 / 5sec' 
}

process {
    executor = 'slurm'
    clusterOptions = '--constraint=cal --signal USR1 --error=job.%J.err --output=job.%J.out'
    //signal = null
    errorStrategy = 'terminate'

    
    
    scratch = false
    //env.TMPDIR = '$PWD'
    //containerOptions = "-B $LOCALSCRATCH:/localscratch"
    
     beforeScript = '''
        module load singularity/3.7.2
    '''
}
