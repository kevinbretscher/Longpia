process {
    cpus = 4
    memory = '8 GB'

    // Per-process overrides must be nested under `process { }`
    withName: 'GET_GENOME_SIZE' {
        cpus = 8
        memory = '16 GB'
    }

    withName: 'SUBSAMPLE' {
        cpus = 8
        memory = '16 GB'
    }

    withName: 'ASSEMBLE' {
        cpus = 32
        memory = '128 GB'
        time = '72h'
    }

    withName: 'COMPRESS' {
        cpus = 16
        memory = '64 GB'
    }

    withName: 'CLUSTER' {
        cpus = 16
        memory = '64 GB'
    }

    withName: 'RESOLVE_CLUSTERS' {
        cpus = 16
        memory = '64 GB'
    }

    withName: 'COMBINE' {
        cpus = 8
        memory = '16 GB'
    }
}
