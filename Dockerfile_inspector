FROM mambaorg/micromamba:latest

# Set working directory
WORKDIR /home/mambauser

# Make local bin for symlinks
RUN mkdir -p /home/mambauser/.local/bin
ENV PATH=/home/mambauser/.local/bin:/opt/conda/envs/ins/bin:$PATH

# Create environment and install inspector + git
RUN micromamba create -y -n ins -c conda-forge -c bioconda inspector git && \
    micromamba clean --all --yes

# Clone Inspector repo
RUN git clone https://github.com/ChongLab/Inspector.git

# Make inspector.py executable and symlink to local bin
RUN chmod +x /home/mambauser/Inspector/inspector.py && \
    ln -s /home/mambauser/Inspector/inspector.py /home/mambauser/.local/bin/inspector

# Also include repo path
ENV PATH=/home/mambauser/Inspector:$PATH

# Default shell
CMD ["bash"]
