profiles {
    slurm {
        includeConfig 'conf/slurm.config'
        includeConfig 'conf/resources.config'
        
        singularity.enabled = true
	    singularity.autoMounts = true
	    process.container = "Containers/autocycler.sif"
	
    }

    local {
        includeConfig 'conf/resources_local.config'
    }
}

params.outdir  = "./test/autocycler_out"
params.samplesheet = "./test/samplesheet.tsv"


//assembly parameters
params.assembler = 'flye'        // options: 'flye', 'Autocycler'
params.flye_options = ''         // Additional options for flye assembler

//autocycler parameters

// Minimum read depth for a sample to be processed
// Autocycler default is 25, however I have observed weird behavior at this threshold. I recommed not go below 30 ideally you would put it at 50 if possible
// Please note that this is the read depth AFTER any filtering has been applied and that an error will be thrown if a sample does not meet this threshold
params.min_read_depth  = 35
params.assembler_list = false
params.plassembler_DB = "./databases/plassembler/201123_plassembler_v1.5.0_databases"

//read filtering and QC

params.filtering = 'none'       // options: 'none', 'filtlong', 'chopper'
params.filtering_arg = ''          // Arguments for the filtering tool

params.run_kraken2 = false
params.kraken2_DB = "./databases/kraken2_standard_20221202"

// Genome QC parameters
params.run_CHECKM = true
params.run_CHECKM2 = true
params.run_BUSCO = true
params.run_QUAST = true
params.run_INSPECTOR = true
params.run_CRAQ = true


params.checkm_DB = "./databases/checkm"
params.checkm2_DB = "./databases/checkm2/CheckM2_database/uniref100.KO.1.dmnd"
params.BUSCO_DB = "./databases/BUSCO"
params.busco_lineage = "bacteria_odb12"

// Annotation parameters

params.run_bakta = true
params.bakta_DB = "./databases/BAKTA/db-light"
params.bakta_args = ""

params.run_prokka = false
params.prokka_DB = "./databases/prokka_db"

//taxonomic classification parameters

params.run_gtdbtk = false
params.gtdbtk_DB = "./databases/gtdbtk_references/release202"

params.run_BARRNAP = false


// Reports and logs


timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}