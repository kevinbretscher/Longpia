profiles {
    slurm {
        includeConfig 'conf/slurm.config'
        includeConfig 'conf/resources.config'
        
        singularity.enabled = true
	    singularity.autoMounts = true
	    process.container = "Containers/Autocycler_gnu.sif"
	
    }

    local {
        includeConfig 'conf/resources_local.config'
    }
}

params.outdir  = "./test/flye"
params.samplesheet = "./test/samplesheet.tsv"


//choose assembly method parameters
params.assembler = 'flye'        // options: 'flye', 'Autocycler'

// Flye assembler parameters
params.flye_options = '--iterations 0'     // Additional options for flye assembler


//autocycler parameters
params.assembler_list = "flye,miniasm,raven"  // List of assemblers to use in Autocycler
params.plassembler_DB = "./databases/plassembler"

// Minimum read depth for a sample to be processed
// Autocycler default is 25, however I have observed weird behavior at this threshold. I recommed not go below 30 ideally you would put it at 50 if possible Please note that this is the read depth AFTER any filtering has been applied and that an error will be thrown if a sample does not meet this threshold
params.min_read_depth  = 30
params.n_samples = 4

//post assembly polishing parameters
params.polishing_tool = 'none'   // options: 'medaka','none'  (other polishing tools not implemented yet)


//read filtering and QC

params.filtering = 'none'       // options: 'none', 'filtlong', 'chopper (not implemented yet)'
params.filtering_arg = ''          // Arguments for the filtering tool

params.run_kraken2 = false // Not implemented yet
params.kraken2_DB = "../databases/bacass_databases/pluspf"

// Genome QC parameters
params.run_CHECKM = true
params.run_CHECKM2 = true
params.run_BUSCO = true
params.run_QUAST = true
params.run_INSPECTOR = true
params.run_CRAQ = true


params.checkm_DB = "./databases/checkm"
params.checkm2_DB = "./databases/checkm2/CheckM2_database/uniref100.KO.1.dmnd"

params.BUSCO_DB = "./databases/BUSCO"
params.busco_lineage = "bacteria_odb12"

// Annotation parameters

params.run_bakta = true
params.bakta_DB = "./databases/BAKTA/db-light"
params.bakta_args = ""

params.run_prokka = false // Not implemented yet
params.prokka_DB = "./databases/prokka_db" 

//taxonomic classification parameters

params.run_gtdbtk = false // Not implemented yet
params.gtdbtk_DB = "./databases/gtdbtk_references/release202"

params.run_barrnap = true // Not implemented yet


// Reports and logs

//tba