profiles {
    slurm {

        includeConfig 'conf/resources.config'
	
    }
    picasso {
        includeConfig 'conf/picasso_slurm.config'
        includeConfig 'conf/resources.config'

        executor.submitRateLimit = '1 / 5sec'  // Limit to 1 job every 5 seconds to allow
        executor.queueSize = 30               // Allow up to 30 jobs in the queue
        
        singularity.enabled = true
	    singularity.autoMounts = true
	
    }
    local {
        includeConfig 'conf/resources_local.config'
    }
}

params.outdir  = "./test/flye"
params.samplesheet = "./test/samplesheet.tsv"


//choose assembly method parameters
params.assembler = 'autocycler'        // options: 'flye', 'autocycler'

// Flye assembler parameters
params.flye_options = '--iterations 0'     // Additional options for flye assembler


//autocycler parameters
params.assembler_list = "canu,flye,metamdbg,miniasm,necat,nextdenovo,raven"  // List of assemblers to use in Autocycler (Comma separated, no spaces)

// available assemblers: canu,flye,metamdbg,miniasm,necat,nextdenovo,raven,plassembler,lja(not tested yet)

params.plassembler_DB = "./databases/plassembler"

// Minimum read depth for a sample to be processed
// Autocycler default is 25, Please note that this is the read depth AFTER any filtering has been applied and that an error will be thrown if a sample does not meet this threshold
params.min_read_depth  = 30
params.n_samples = 4

//post assembly polishing parameters
params.polishing_tool = 'medaka'   // options: 'medaka','none'  (other polishing tools not implemented yet)

//read filtering and QC

params.filtering = 'none'       // options: 'none', 'filtlong', 'chopper (not implemented yet), fastp (not implemented yet)'
params.filtering_arg = '--min_length 1kb --keep_percent 90 --target_bases 500mb'          // Arguments for the filtering tool

params.run_kraken2 = true 
params.kraken2_DB = "../databases/bacass_databases/pluspf"

// Genome QC parameters
params.run_CHECKM = true
params.run_CHECKM2 = true
params.run_BUSCO = false
params.run_QUAST = true
params.run_INSPECTOR = true
params.run_CRAQ = true


params.checkm_DB = "./databases/checkm"
params.checkm2_DB = "./databases/checkm2/CheckM2_database/uniref100.KO.1.dmnd"

params.BUSCO_DB = "./databases/BUSCO"
params.busco_lineage = "bacteria_odb12"

// Annotation parameters

params.run_bakta = true
params.bakta_DB = "./databases/BAKTA/db-light"
params.bakta_args = ""

params.run_prokka = false // Not implemented yet

params.run_barrnap = true

//taxonomic classification parameters

params.run_skani = true 
params.skani_DB = "./databases/skani/skani_gtdb_r226-v0.3"


// Reports and logs

